# Copy to .env and adjust. Never commit the real .env.
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/campusquest
# Use a long random string in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-in-production
# Streak/quest day boundaries are calculated in this IANA timezone (SRS 6.6.2)
APP_TIMEZONE=Asia/Karachi

# Public address of the site, no trailing slash. Used in email links and the Google redirect.
APP_URL=http://localhost:3000

# ---- Outgoing email (verification, password reset, invitations) ----
# Leave SMTP_HOST empty in development: emails are printed to the server console instead.
# Required in production. Gmail example: smtp.gmail.com / 465 / your address / a Google "App password".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusQuest <no-reply@your-college.edu>

# ---- Continue with Google ----
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only allow sign-up with these email domains (comma separated). Empty = any domain.
ALLOWED_EMAIL_DOMAINS=

# Optional bootstrap admin, created on start-up only if no admin exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Show the seeded demo accounts on the login page (development only).
SHOW_DEMO_ACCOUNTS=false
